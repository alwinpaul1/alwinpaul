---
import { siteConfig } from "../config";
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-ink"
        >
          About Me
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full bg-accent"></div>
      </div>

      <div class="lg:col-span-8 space-y-8">
        <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-body">
          {siteConfig.aboutMe}
        </p>

        <div class="pt-4 space-y-6">
          {
            siteConfig.skills.map((group) => (
              <div>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-faint">
                  {group.category}
                </h3>
                <div class="flex flex-wrap gap-3">
                  {group.items.map((skill) => (
                    <span class="px-3 sm:px-4 py-1.5 sm:py-2 bg-chip text-ink-soft rounded-full text-sm sm:text-base font-medium hover:bg-chip-hover transition-colors duration-200">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
