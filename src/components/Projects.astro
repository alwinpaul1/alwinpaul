---
import { siteConfig } from "../config";
import ProjectCard from "./ProjectCard.astro";
import Section from "./Section.astro";

const { projects, achievements } = siteConfig;
---

{
  (projects.length > 0 || achievements.length > 0) && (
    <Section id="projects" title="Projects">
      <div class="space-y-16">
        {projects.length > 0 && (
          <div class="space-y-8">
            {projects.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        )}

        {achievements.length > 0 && (
          <div id="achievements" class="space-y-8">
            <div class="pt-4">
              <h3 class="text-3xl sm:text-4xl font-bold text-ink text-balance">Achievements</h3>
              <div class="w-12 h-1 mt-2 rounded-full bg-accent"></div>
            </div>
            {achievements.map((achievement, index) => (
              <ProjectCard project={achievement} index={index} headingTag="h4" />
            ))}
          </div>
        )}
      </div>
    </Section>
  )
}
