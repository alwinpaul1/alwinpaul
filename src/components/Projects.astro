---
import { siteConfig } from "../config";
import ProjectCard from "./ProjectCard.astro";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasAchievements =
  siteConfig.achievements && siteConfig.achievements.length > 0;
---

{
  (hasProjects || hasAchievements) && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-ink">
              Projects
            </h2>
            <div class="w-[75px] h-[5px] mt-2 rounded-full bg-accent" />
          </div>

          <div class="lg:col-span-8 space-y-16">
            {hasProjects && (
              <div class="space-y-8">
                {siteConfig.projects.map((project, index) => (
                  <ProjectCard project={project} index={index} />
                ))}
              </div>
            )}

            {hasAchievements && (
              <div id="achievements" class="scroll-mt-24 space-y-8">
                <h3 class="text-2xl sm:text-3xl font-bold text-ink">
                  Achievements
                </h3>
                {siteConfig.achievements.map((achievement, index) => (
                  <ProjectCard project={achievement} index={index} />
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}
