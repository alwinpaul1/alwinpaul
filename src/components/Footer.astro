---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import { navLinks } from "../navigation";

const { contact, social } = siteConfig;
---

<footer id="contact" class="relative bg-surface border-t border-line">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-8"
    >
      <div class="flex flex-col gap-4">
        <p class="text-2xl font-bold text-ink" translate="no">
          {siteConfig.name}
        </p>
        <p class="text-base text-body">
          {siteConfig.title}
        </p>
        <ul class="flex flex-col gap-2 text-sm text-body">
          {
            contact?.location && (
              <li class="flex items-center gap-2">
                <Icon name="mapPin" class="h-4 w-4 shrink-0" />
                {contact.location}
              </li>
            )
          }
          {
            social?.email && (
              <li class="flex items-center gap-2">
                <Icon name="mail" class="h-4 w-4 shrink-0" />
                <a href={`mailto:${social.email}`} class="hover:text-accent transition-colors">
                  {social.email}
                </a>
              </li>
            )
          }
          {
            contact?.phone && (
              <li class="flex items-center gap-2">
                <Icon name="phone" class="h-4 w-4 shrink-0" />
                <a href={`tel:${contact.phone}`} class="hover:text-accent transition-colors">
                  {contact.phone}
                </a>
              </li>
            )
          }
        </ul>
        <div class="flex flex-wrap gap-x-6 gap-y-3 text-body">
          <SocialLinks iconClass="h-6 w-6" />
        </div>
      </div>

      <div class="flex flex-col md:items-end gap-4">
        <nav aria-label="Footer" class="hidden md:flex gap-x-8">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm text-body hover:text-ink transition-colors"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <p class="text-sm text-faint">
          {`© ${new Date().getFullYear()} ${siteConfig.name}. All rights reserved.`}
        </p>
      </div>
    </div>
  </div>

  <!-- Decorative pattern -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <svg
      aria-hidden="true"
      class="absolute bottom-0 left-0 w-full h-24 text-line-soft"
    >
      <pattern
        id="footer-pattern"
        x="0"
        y="0"
        width="100"
        height="100"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M0 50 Q 25 40, 50 50 T 100 50"
          stroke="currentColor"
          stroke-width="0.5"
          fill="none"
          opacity="0.4"></path>
      </pattern>
      <rect width="100%" height="100%" fill="url(#footer-pattern)"></rect>
    </svg>
  </div>
</footer>
