---
import { siteConfig } from "../config";
import EntryCard from "./EntryCard.astro";
import Section from "./Section.astro";

const { education } = siteConfig;
---

{
  education.length > 0 && (
    <Section id="education" title="Education">
      <div class="space-y-8">
        {education.map((edu) => (
          <EntryCard
            title={edu.degree}
            organization={edu.school}
            dateRange={edu.dateRange}
            items={edu.achievements}
          />
        ))}
      </div>
    </Section>
  )
}
