---
import { siteConfig } from "../config";
import Section from "./Section.astro";

const { skills } = siteConfig;

// "German (A2, improving)" renders the part in brackets as a quieter note
const NOTE_PATTERN = /^(.*?)\s*\((.+)\)$/;
const splitNote = (item: string) => {
  const match = item.match(NOTE_PATTERN);
  return match ? { name: match[1], note: match[2] } : { name: item, note: "" };
};
---

{
  skills.length > 0 && (
    <Section id="skills" title="Skills">
      <dl class="divide-y divide-line border-y border-line">
        {skills.map((group) => (
          <div class="grid grid-cols-1 sm:grid-cols-[12rem_1fr] gap-3 sm:gap-8 py-5 sm:py-6">
            <dt class="text-sm font-semibold text-ink sm:pt-1">{group.category}</dt>
            <dd class="flex flex-wrap gap-2" translate="no">
              {group.items.map((item) => {
                const { name, note } = splitNote(item);
                return (
                  <span class="px-2.5 py-1 rounded-md border border-line text-sm text-ink-soft">
                    {name}
                    {note && <span class="text-faint"> · {note}</span>}
                  </span>
                );
              })}
            </dd>
          </div>
        ))}
      </dl>
    </Section>
  )
}
