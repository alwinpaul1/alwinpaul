---
import { siteConfig } from "../config";
import { streamTokens } from "../lib/stream";
import SocialLinks from "./SocialLinks.astro";
import StreamText from "./StreamText.astro";

// The title starts streaming once the name has landed; the role line and
// social links arrive as it finishes
const STREAM_START = 420;
const { end: streamEnd } = streamTokens(siteConfig.title, STREAM_START);
const current = siteConfig.experience[0];
const currentCompany = current?.company.split(" · ")[0];
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-canvas min-h-svh flex flex-col"
>
  <!-- Gradient overlay -->
  <div class="hero-glow absolute inset-0 -z-10"></div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-line [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="hero-grid"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
      <pattern
        id="programming-symbols"
        x="0"
        y="0"
        width="400"
        height="400"
        patternUnits="userSpaceOnUse"
      >
        <text
          x="50"
          y="50"
          fill="var(--accent)"
          font-family="monospace"
          font-size="24"
          transform="rotate(-15)">&lt;/&gt;</text
        >
        <text
          x="150"
          y="100"
          fill="var(--accent)"
          font-family="monospace"
          font-size="20"
          transform="rotate(10)">{}</text
        >
        <text
          x="250"
          y="80"
          fill="var(--accent)"
          font-family="monospace"
          font-size="18"
          transform="rotate(-5)">=&gt;</text
        >
        <text
          x="100"
          y="200"
          fill="var(--accent)"
          font-family="monospace"
          font-size="22"
          transform="rotate(15)">[]</text
        >
        <text
          x="300"
          y="180"
          fill="var(--accent)"
          font-family="monospace"
          font-size="20"
          transform="rotate(-10)">&lt;&gt;</text
        >
        <text
          x="200"
          y="250"
          fill="var(--accent)"
          font-family="monospace"
          font-size="24"
          transform="rotate(5)">()</text
        >
        <text
          x="50"
          y="320"
          fill="var(--accent)"
          font-family="monospace"
          font-size="18"
          transform="rotate(-8)">::</text
        >
        <text
          x="350"
          y="300"
          fill="var(--accent)"
          font-family="monospace"
          font-size="22"
          transform="rotate(12)">==</text
        >
        <text
          x="150"
          y="350"
          fill="var(--accent)"
          font-family="monospace"
          font-size="20"
          transform="rotate(-15)">++</text
        >
        <text
          x="250"
          y="370"
          fill="var(--accent)"
          font-family="monospace"
          font-size="24"
          transform="rotate(8)">;</text
        >
      </pattern>
    </defs>
    <rect
      fill="url(#programming-symbols)"
      width="100%"
      height="100%"
      opacity="0.2"></rect>
    <rect
      fill="url(#hero-grid)"
      width="100%"
      height="100%"
      stroke-width={0}></rect>
  </svg>
  <svg id="hero-spotlight" aria-hidden="true" class="absolute inset-0 -z-10 size-full opacity-0 transition-opacity duration-300">
    <defs>
      <pattern x="50%" y={-1} id="hero-grid-lit" width={200} height={200} patternUnits="userSpaceOnUse">
        <path d="M.5 200V.5H200" fill="none" stroke="var(--accent)" stroke-opacity="0.6"></path>
      </pattern>
    </defs>
    <rect fill="url(#programming-symbols)" width="100%" height="100%" opacity="0.75"></rect>
    <rect fill="url(#hero-grid-lit)" width="100%" height="100%"></rect>
  </svg>
  <!-- Text takes the free height and centres in it; top padding clears the fixed header -->
  <div class="flex-1 flex items-center px-8 sm:px-12 md:px-16 lg:px-24 pt-24 pb-10">
    <div>
      <p
        class="greeting text-pretty text-[clamp(1.25rem,5.5vw,1.5rem)] sm:text-2xl md:text-5xl font-bold tracking-tight text-ink-soft animate-fade-in"
      >
        Hello! <span class="wave inline-block" aria-hidden="true">👋</span>
      </p>
      <h1
        class="mt-6 sm:mt-8 md:mt-10 text-balance text-[clamp(2rem,9.5vw,3rem)] sm:text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight text-ink animate-fade-in animation-delay-1"
      >
        I’m <span class="text-accent" translate="no">{siteConfig.name}</span>
      </h1>
      <p
        class="mt-4 sm:mt-6 md:mt-8 max-w-[60ch] text-pretty text-[clamp(1rem,4.5vw,1.125rem)] sm:text-lg md:text-xl/8 font-medium text-body"
      >
        <StreamText text={siteConfig.title} start={STREAM_START} />
      </p>
      {
        current && (
          <p
            class="mt-3 sm:mt-4 flex items-center gap-2.5 text-sm sm:text-base text-faint animate-fade-in"
            style={`animation-delay: ${streamEnd}ms`}
          >
            <span class="live-dot relative size-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>
              {current.title} at <span translate="no">{currentCompany}</span>
            </span>
          </p>
        )
      }
    </div>
  </div>
  <div
    class="px-8 sm:px-12 md:px-16 lg:px-24 pb-10 sm:pb-12 md:pb-16 lg:pb-24 flex flex-wrap gap-x-4 sm:gap-x-6 md:gap-x-8 gap-y-4 text-ink-soft animate-fade-in"
    style={`animation-delay: ${streamEnd}ms`}
  >
    <SocialLinks iconClass="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8" />
  </div>
</div>

<script>
  const hero = document.getElementById("hero");
  const spotlight = document.getElementById("hero-spotlight");

  // The live dot's pulse is a loop, so it only runs while the hero is on screen
  if (hero) {
    new IntersectionObserver(([entry]) => {
      hero.toggleAttribute("data-offscreen", !entry.isIntersecting);
    }).observe(hero);
  }

  // Cursor spotlight: desktop pointers only, and never with reduced motion
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (hero && spotlight && canHover.matches && !reduceMotion.matches) {
    let target = { x: 0, y: 0 };
    let current = { x: 0, y: 0 };
    let frame = 0;

    // Ease toward the pointer each frame, so the light trails it slightly
    const tick = () => {
      current.x += (target.x - current.x) * 0.14;
      current.y += (target.y - current.y) * 0.14;
      spotlight.style.setProperty("--x", `${current.x}px`);
      spotlight.style.setProperty("--y", `${current.y}px`);
      frame =
        Math.abs(target.x - current.x) + Math.abs(target.y - current.y) > 0.5
          ? requestAnimationFrame(tick)
          : 0;
    };

    hero.addEventListener("pointermove", (event) => {
      const rect = hero.getBoundingClientRect();
      target = { x: event.clientX - rect.left, y: event.clientY - rect.top };
      if (spotlight.style.opacity !== "1") {
        current = { ...target };
        spotlight.style.opacity = "1";
      }
      if (!frame) frame = requestAnimationFrame(tick);
    });
    hero.addEventListener("pointerleave", () => {
      spotlight.style.opacity = "0";
    });
  }
</script>

<style>
  .hero-glow {
    background: radial-gradient(
      ellipse 800px 1200px at 0% 0%,
      color-mix(in srgb, var(--accent) 25%, transparent) 0%,
      color-mix(in srgb, var(--accent) 15%, transparent) 20%,
      color-mix(in srgb, var(--accent) 6%, transparent) 40%,
      color-mix(in srgb, var(--canvas) 30%, transparent) 70%,
      color-mix(in srgb, var(--canvas) 80%, transparent) 90%,
      var(--canvas) 100%
    );
  }

  /*
   * Entrance: each line fades and rises into place with a slight blur-in,
   * staggered 80ms apart. Plays once per visit, so it can afford some delight.
   */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
      filter: blur(4px);
    }
  }

  @keyframes fadeOnly {
    from {
      opacity: 0;
    }
  }

  .animate-fade-in {
    animation: fadeIn 600ms var(--ease-out) both;
  }

  .animation-delay-1 {
    animation-delay: 80ms;
  }

  /* The hand waves once as the greeting lands, and again on hover */
  .wave {
    transform-origin: 70% 75%;
    animation: wave 1.8s var(--ease-out) 700ms both;
  }

  @media (hover: hover) {
    .greeting:hover .wave {
      animation: wave-again 1.2s var(--ease-out);
    }
  }

  @keyframes wave {
    0%,
    60%,
    100% {
      rotate: 0deg;
    }
    10%,
    30% {
      rotate: 16deg;
    }
    20% {
      rotate: -8deg;
    }
    40% {
      rotate: -4deg;
    }
    50% {
      rotate: 10deg;
    }
  }

  /* Same motion under a new name, so hovering restarts it */
  @keyframes wave-again {
    0%,
    100% {
      rotate: 0deg;
    }
    15%,
    45% {
      rotate: 16deg;
    }
    30% {
      rotate: -8deg;
    }
    60% {
      rotate: -4deg;
    }
    75% {
      rotate: 8deg;
    }
  }

  /* A soft ring spreads from the dot, like a status light */
  .live-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent);
    animation: ping 2.4s var(--ease-out) infinite;
  }

  :global(#hero[data-offscreen]) .live-dot::after {
    animation-play-state: paused;
  }

  @keyframes ping {
    0% {
      scale: 1;
      opacity: 0.55;
    }
    70%,
    100% {
      scale: 3;
      opacity: 0;
    }
  }

  /* The spotlight only shows grid and symbols inside a soft circle at the pointer */
  #hero-spotlight {
    mask-image: radial-gradient(circle 240px at var(--x, -999px) var(--y, -999px), #000 0%, rgb(0 0 0 / 0.45) 45%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle 240px at var(--x, -999px) var(--y, -999px), #000 0%, rgb(0 0 0 / 0.45) 45%, transparent 100%);
  }

  /* Reduced motion keeps the fades but drops movement and blur */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation-name: fadeOnly;
      animation-duration: 200ms;
    }

    .wave,
    .greeting:hover .wave,
    .live-dot::after {
      animation: none;
    }
  }
</style>
