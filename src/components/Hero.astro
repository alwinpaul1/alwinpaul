---
import { siteConfig } from "../config";
import SocialLinks from "./SocialLinks.astro";

// Split the title the way a subword tokenizer would: leading spaces stay on
// the word, punctuation is its own token, and long words break in two
const TOKEN_PATTERN = /\s*[\p{L}\p{N}]+|\s*[^\s\p{L}\p{N}]/gu;
const pieces = (siteConfig.title.match(TOKEN_PATTERN) ?? []).flatMap((piece) => {
  const word = piece.trimStart();
  if (word.length < 8) return [piece];
  const cut = piece.length - Math.floor(word.length * 0.45);
  return [piece.slice(0, cut), piece.slice(cut)];
});

// Real streams arrive in uneven bursts, so the gaps between tokens vary
const STREAM_START = 420; // ms, once the name has landed
const GAPS = [48, 36, 70, 42, 55, 38, 92, 44, 51, 35, 66, 40, 58, 47, 83, 39];
let clock = STREAM_START;
const tokens = pieces.map((text, i) => {
  const start = clock;
  clock += GAPS[i % GAPS.length];
  return { text, start, end: clock };
});
const streamEnd = clock;
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-canvas min-h-svh flex flex-col"
>
  <!-- Gradient overlay -->
  <div class="hero-glow absolute inset-0 -z-10"></div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-line [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="hero-grid"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
      <pattern
        id="programming-symbols"
        x="0"
        y="0"
        width="400"
        height="400"
        patternUnits="userSpaceOnUse"
      >
        <text
          x="50"
          y="50"
          fill="var(--accent)"
          font-family="monospace"
          font-size="24"
          transform="rotate(-15)">&lt;/&gt;</text
        >
        <text
          x="150"
          y="100"
          fill="var(--accent)"
          font-family="monospace"
          font-size="20"
          transform="rotate(10)">{}</text
        >
        <text
          x="250"
          y="80"
          fill="var(--accent)"
          font-family="monospace"
          font-size="18"
          transform="rotate(-5)">=&gt;</text
        >
        <text
          x="100"
          y="200"
          fill="var(--accent)"
          font-family="monospace"
          font-size="22"
          transform="rotate(15)">[]</text
        >
        <text
          x="300"
          y="180"
          fill="var(--accent)"
          font-family="monospace"
          font-size="20"
          transform="rotate(-10)">&lt;&gt;</text
        >
        <text
          x="200"
          y="250"
          fill="var(--accent)"
          font-family="monospace"
          font-size="24"
          transform="rotate(5)">()</text
        >
        <text
          x="50"
          y="320"
          fill="var(--accent)"
          font-family="monospace"
          font-size="18"
          transform="rotate(-8)">::</text
        >
        <text
          x="350"
          y="300"
          fill="var(--accent)"
          font-family="monospace"
          font-size="22"
          transform="rotate(12)">==</text
        >
        <text
          x="150"
          y="350"
          fill="var(--accent)"
          font-family="monospace"
          font-size="20"
          transform="rotate(-15)">++</text
        >
        <text
          x="250"
          y="370"
          fill="var(--accent)"
          font-family="monospace"
          font-size="24"
          transform="rotate(8)">;</text
        >
      </pattern>
    </defs>
    <rect
      fill="url(#programming-symbols)"
      width="100%"
      height="100%"
      opacity="0.2"></rect>
    <rect
      fill="url(#hero-grid)"
      width="100%"
      height="100%"
      stroke-width={0}></rect>
  </svg>
  <!-- Text takes the free height and centres in it; top padding clears the fixed header -->
  <div class="flex-1 flex items-center px-8 sm:px-12 md:px-16 lg:px-24 pt-24 pb-10">
    <div>
      <p
        class="text-pretty text-[clamp(1.25rem,5.5vw,1.5rem)] sm:text-2xl md:text-5xl font-bold tracking-tight text-ink-soft animate-fade-in"
      >
        Hello! <span aria-hidden="true">👋</span>
      </p>
      <h1
        class="mt-6 sm:mt-8 md:mt-10 text-balance text-[clamp(2rem,9.5vw,3rem)] sm:text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight text-ink animate-fade-in animation-delay-1"
      >
        I’m <span class="text-accent" translate="no">{siteConfig.name}</span>
      </h1>
      <p
        class="mt-4 sm:mt-6 md:mt-8 max-w-[60ch] text-pretty text-[clamp(1rem,4.5vw,1.125rem)] sm:text-lg md:text-xl/8 font-medium text-body"
      >
        <span class="sr-only">{siteConfig.title}</span>
        <span aria-hidden="true">
          {
            tokens.map((token, i) => (
              <span
                class:list={["token", { "token-last": i === tokens.length - 1 }]}
                style={`--start: ${token.start}ms; --end: ${token.end}ms`}
              >
                {token.text}
              </span>
            ))
          }
        </span>
      </p>
    </div>
  </div>
  <div
    class="px-8 sm:px-12 md:px-16 lg:px-24 pb-10 sm:pb-12 md:pb-16 lg:pb-24 flex flex-wrap gap-x-4 sm:gap-x-6 md:gap-x-8 gap-y-4 text-ink-soft animate-fade-in"
    style={`animation-delay: ${streamEnd}ms`}
  >
    <SocialLinks iconClass="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8" />
  </div>
</div>

<style>
  .hero-glow {
    background: radial-gradient(
      ellipse 800px 1200px at 0% 0%,
      color-mix(in srgb, var(--accent) 25%, transparent) 0%,
      color-mix(in srgb, var(--accent) 15%, transparent) 20%,
      color-mix(in srgb, var(--accent) 6%, transparent) 40%,
      color-mix(in srgb, var(--canvas) 30%, transparent) 70%,
      color-mix(in srgb, var(--canvas) 80%, transparent) 90%,
      var(--canvas) 100%
    );
  }

  /*
   * Entrance: each line fades and rises into place with a slight blur-in,
   * staggered 80ms apart. Plays once per visit, so it can afford some delight.
   */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
      filter: blur(4px);
    }
  }

  @keyframes fadeOnly {
    from {
      opacity: 0;
    }
  }

  .animate-fade-in {
    animation: fadeIn 600ms var(--ease-out) both;
  }

  .animation-delay-1 {
    animation-delay: 80ms;
  }

  /*
   * The title streams in token by token, like a model's response. Each token
   * sharpens out of a blur, and the caret rides on the newest token, then
   * blinks a few times at the end before going away.
   */
  .token {
    position: relative;
    animation: tokenIn 280ms var(--ease-out) var(--start) both;
  }

  .token::after {
    content: "";
    position: absolute;
    left: calc(100% + 0.1em);
    top: 50%;
    width: 0.55em;
    height: 1.15em;
    translate: 0 -50%;
    background: var(--accent);
    opacity: 0;
    animation: caretOn calc(var(--end) - var(--start)) var(--start);
  }

  .token-last::after {
    animation: caretBlink 530ms step-end var(--start) 3;
  }

  @keyframes tokenIn {
    from {
      opacity: 0;
      filter: blur(3px);
    }
  }

  @keyframes caretOn {
    from,
    to {
      opacity: 1;
    }
  }

  @keyframes caretBlink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* Reduced motion keeps the fades but drops movement, blur, and the caret */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation-name: fadeOnly;
      animation-duration: 200ms;
    }

    .token {
      animation-name: fadeOnly;
    }

    .token::after {
      display: none;
    }
  }
</style>
