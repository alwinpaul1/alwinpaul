---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
import { contactLink, navLinks } from "../navigation";
---

<header
  id="header"
  class="group fixed top-0 left-0 right-0 z-50 transition-[background-color,backdrop-filter] duration-200 data-scrolled:bg-canvas/80 data-scrolled:backdrop-blur-sm"
>
  <nav
    aria-label="Main"
    class="relative h-16 px-8 sm:px-12 md:px-16 lg:px-24 grid grid-cols-[1fr_auto_1fr] items-center gap-6"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-1/2 focus:-translate-y-1/2 focus:px-3 focus:py-2 focus:rounded-md focus:bg-canvas focus:text-ink focus:shadow-md"
    >
      Skip to content
    </a>

    <!-- The hero already shows the name large; this one arrives once that scrolls away -->
    <a
      href="#hero"
      translate="no"
      class="col-start-1 justify-self-start whitespace-nowrap text-lg font-bold tracking-tight text-ink invisible opacity-0 translate-y-1 group-data-scrolled:visible group-data-scrolled:opacity-100 group-data-scrolled:translate-y-0 transition-[opacity,translate,visibility] duration-300 ease-out"
    >
      {siteConfig.name}
    </a>

    <div class="col-start-2 hidden md:flex items-center gap-7">
      <ul id="nav-links" class="relative flex items-center gap-7">
        {
          [...navLinks, contactLink].map((link) => (
            <li>
              <a
                href={link.href}
                data-section-link
                class="text-ink-soft hover:text-ink aria-[current=location]:text-ink transition-colors font-medium"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <!-- Slides under the link for the section in view -->
        <li
          id="nav-indicator"
          aria-hidden="true"
          class="absolute left-0 -bottom-1.5 h-0.5 w-px origin-left bg-accent opacity-0 pointer-events-none"
        >
        </li>
      </ul>

      {
        siteConfig.resume && (
          <a
            href={siteConfig.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-full border border-accent px-4 py-1.5 text-sm font-semibold text-accent hover:bg-accent hover:text-canvas active:scale-[0.97] transition-[color,background-color,scale] duration-150 ease-out"
          >
            Resume
          </a>
        )
      }
    </div>

    <!-- Pinned to the last column: on phones the centre group is hidden and would otherwise let this slide into the middle -->
    <div class="col-start-3 justify-self-end -mr-2 flex items-center gap-1">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
        class="grid place-items-center size-10 rounded-full text-ink-soft hover:text-ink hover:bg-chip active:scale-95 transition-[color,background-color,scale] duration-150 ease-out"
      >
        <Icon name="moon" class="theme-icon theme-icon-moon col-start-1 row-start-1 size-5" />
        <Icon name="sun" class="theme-icon theme-icon-sun col-start-1 row-start-1 size-5" />
      </button>

      <button
        id="menu-toggle"
        type="button"
        popovertarget="mobile-menu"
        aria-label="Menu"
        class="md:hidden grid place-items-center size-10 rounded-full text-ink-soft hover:text-ink hover:bg-chip active:scale-95 transition-[color,background-color,scale] duration-150 ease-out"
      >
        <span class="menu-line menu-line-top col-start-1 row-start-1 h-0.5 w-5 rounded-full bg-current"></span>
        <span class="menu-line menu-line-bottom col-start-1 row-start-1 h-0.5 w-5 rounded-full bg-current"></span>
      </button>
    </div>
  </nav>

  <!--
    Phone menu. A native popover renders in the top layer, so it needs no
    z-index, and it closes on Esc or a tap outside, returning focus to the button.
  -->
  <div id="mobile-menu" popover class="md:hidden">
    <nav aria-label="Mobile">
      <ul>
        {
          [...navLinks, contactLink].map((link) => (
            <li>
              <a
                href={link.href}
                data-mobile-link
                class="flex items-center rounded-xl px-4 py-3 text-lg font-medium text-ink-soft hover:bg-chip hover:text-ink aria-[current=location]:text-ink aria-[current=location]:font-semibold active:scale-[0.98] transition-[color,background-color,scale] duration-150 ease-out"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        siteConfig.resume && (
          <a
            href={siteConfig.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 flex items-center justify-center rounded-full border border-accent px-4 py-3 font-semibold text-accent hover:bg-accent hover:text-canvas active:scale-[0.98] transition-[color,background-color,scale] duration-150 ease-out"
          >
            Resume
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("header");
  const toggle = document.getElementById("theme-toggle");
  const root = document.documentElement;

  // Only touch the DOM when the state flips, not on every scroll event
  let scrolled: boolean | undefined;
  const syncScrolled = () => {
    const next = window.scrollY > 100;
    if (next === scrolled) return;
    scrolled = next;
    header?.toggleAttribute("data-scrolled", next);
  };
  syncScrolled();
  window.addEventListener("scroll", syncScrolled, { passive: true });

  const syncPressed = () =>
    toggle?.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
  syncPressed();

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // The new theme grows out of the toggle in a circle, so the change visibly
  // starts where the click happened. Falls back to an instant swap.
  toggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    const commit = () => {
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Storage can be blocked (private mode); the toggle still works for this visit
      }
    };

    if (!document.startViewTransition || reduceMotion.matches) {
      commit();
      return;
    }

    const { left, top, width, height } = toggle.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    document.startViewTransition(commit).ready.then(() => {
      root.animate(
        {
          clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`],
        },
        {
          duration: 450,
          easing: "cubic-bezier(0.16, 1, 0.3, 1)",
          pseudoElement: "::view-transition-new(root)",
        },
      );
    });
  });

  // Scroll spy: mark the nav link for the section crossing the upper-middle of
  // the viewport. The footer is too short to reach that line, so Contact
  // takes over once half of it is on screen. Sections without a nav link
  // (Education, GitHub, Skills) leave the underline hidden.
  const list = document.getElementById("nav-links");
  const indicator = document.getElementById("nav-indicator");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-section-link]")];
  const contact = links.find((link) => link.hash === "#contact");
  const sectionLinks = links.filter((link) => link !== contact);
  const inView = new Set<string>();
  let footerInView = false;
  let active: HTMLAnchorElement | undefined;

  const placeIndicator = (instant: boolean) => {
    if (!indicator) return;
    if (!active) {
      indicator.style.opacity = "0";
      return;
    }
    // Arriving from hidden should not sweep in from the far left
    indicator.style.transition = instant
      ? "opacity 200ms ease"
      : "transform 350ms var(--ease-out), opacity 200ms ease";
    indicator.style.transform = `translateX(${active.offsetLeft}px) scaleX(${active.offsetWidth})`;
    indicator.style.opacity = "1";
  };

  const mobileLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]")];

  const updateActive = () => {
    const next =
      footerInView && contact
        ? contact
        : sectionLinks.findLast((link) => inView.has(link.hash.slice(1)));
    if (next === active) return;
    for (const link of mobileLinks) {
      if (link.hash === next?.hash) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    }
    const wasHidden = !active;
    active?.removeAttribute("aria-current");
    next?.setAttribute("aria-current", "location");
    active = next;
    placeIndicator(wasHidden);
  };

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) inView.add(entry.target.id);
        else inView.delete(entry.target.id);
      }
      updateActive();
    },
    { rootMargin: "-40% 0px -55% 0px" },
  );

  for (const link of sectionLinks) {
    const target = document.getElementById(link.hash.slice(1));
    if (target) sectionObserver.observe(target);
  }

  const footer = document.getElementById("contact");
  if (footer && contact) {
    new IntersectionObserver(
      ([entry]) => {
        footerInView = entry.isIntersecting;
        updateActive();
      },
      { threshold: 0.5 },
    ).observe(footer);
  }

  // Phone menu: close after picking a link, and if the viewport grows past
  // the breakpoint while it is open (e.g. rotating a tablet)
  const menu = document.getElementById("mobile-menu");
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) menu.hidePopover();
  });
  window.matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
    if (event.matches && menu?.matches(":popover-open")) menu.hidePopover();
  });

  if (list) new ResizeObserver(() => placeIndicator(true)).observe(list);

  new MutationObserver(syncPressed).observe(root, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>

<style>
  /*
   * Sun and moon share one grid cell and crossfade; the blur hides the overlap.
   * The icons render inside <Icon>, so reach them through the scoped button.
   */
  #theme-toggle :global(.theme-icon) {
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out),
      filter 200ms var(--ease-out);
  }

  #theme-toggle :global(.theme-icon-sun),
  :global([data-theme="dark"]) #theme-toggle :global(.theme-icon-moon) {
    opacity: 0;
    transform: scale(0.6) rotate(-45deg);
    filter: blur(2px);
  }

  :global([data-theme="dark"]) #theme-toggle :global(.theme-icon-sun) {
    opacity: 1;
    transform: none;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #theme-toggle :global(.theme-icon) {
      transition: opacity 150ms ease;
    }
  }

  /* Menu icon: two lines that turn into an X while the menu is open */
  .menu-line {
    transition: transform 220ms var(--ease-out);
  }

  .menu-line-top {
    transform: translateY(-3.5px);
  }

  .menu-line-bottom {
    transform: translateY(3.5px);
  }

  header:has(#mobile-menu:popover-open) .menu-line-top {
    transform: rotate(45deg);
  }

  header:has(#mobile-menu:popover-open) .menu-line-bottom {
    transform: rotate(-45deg);
  }

  /*
   * Menu panel: drops in under the header and grows from the button's corner.
   * Opening takes 220ms; closing is quicker at 150ms.
   */
  #mobile-menu {
    position: fixed;
    inset: 4.5rem 1rem auto;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: var(--canvas);
    color: var(--ink);
    box-shadow: 0 16px 40px -12px rgb(0 0 0 / 0.25);
    transform-origin: top right;
    opacity: 0;
    transform: translateY(-8px) scale(0.97);
    transition:
      opacity 150ms ease,
      transform 150ms var(--ease-out),
      overlay 150ms allow-discrete,
      display 150ms allow-discrete;
  }

  #mobile-menu:popover-open {
    opacity: 1;
    transform: none;
    transition-duration: 220ms;
  }

  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
      transform: translateY(-8px) scale(0.97);
    }
  }

  #mobile-menu::backdrop {
    background: transparent;
    transition:
      background-color 200ms ease,
      overlay 200ms allow-discrete,
      display 200ms allow-discrete;
  }

  #mobile-menu:popover-open::backdrop {
    background: rgb(0 0 0 / 0.2);
  }

  @starting-style {
    #mobile-menu:popover-open::backdrop {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-line {
      transition: none;
    }

    #mobile-menu {
      transform: none;
      transition-property: opacity, overlay, display;
    }

    @starting-style {
      #mobile-menu:popover-open {
        transform: none;
      }
    }
  }
</style>
