---
import { siteConfig } from "../config";
import Section from "./Section.astro";

const { githubStats, social } = siteConfig;
---

{
  githubStats.length > 0 && (
    <Section id="github" title="GitHub">
      {social.github && (
        <a
          slot="aside"
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
          translate="no"
          class="inline-block mt-6 text-base sm:text-lg text-accent hover:underline underline-offset-4"
        >
          {social.github.replace("https://", "")}
        </a>
      )}

      <div class="grid grid-cols-1 2xl:grid-cols-2 gap-6">
        {githubStats.map((stat) => (
          <div>
            {/* One variant per theme; the hidden one is display:none, so lazy loading skips it */}
            <img
              src={stat.light}
              alt={stat.alt}
              width={stat.width}
              height={stat.height}
              loading="lazy"
              decoding="async"
              class="dark:hidden w-full h-auto rounded-lg border border-line shadow-sm"
            />
            <img
              src={stat.dark}
              alt={stat.alt}
              width={stat.width}
              height={stat.height}
              loading="lazy"
              decoding="async"
              class="hidden dark:block w-full h-auto rounded-lg border border-line shadow-sm"
            />
          </div>
        ))}
      </div>
    </Section>
  )
}
