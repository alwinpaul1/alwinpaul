---
// Shared two-column section: heading on the left, content on the right.
// Anything passed with slot="aside" sits under the heading.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
    <div class="lg:col-span-4">
      <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-ink text-balance">
        {title}
      </h2>
      <div class="w-[75px] h-[5px] mt-2 rounded-full bg-accent"></div>
      <slot name="aside" />
    </div>

    <div class="lg:col-span-8">
      <slot />
    </div>
  </div>
</section>
