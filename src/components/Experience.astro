---
import { siteConfig } from "../config";
import EntryCard from "./EntryCard.astro";
import Section from "./Section.astro";

const { experience } = siteConfig;
// A timeline needs at least two stops; a lone dot above one card reads as noise
const showTimeline = experience.length > 1;
---

{
  experience.length > 0 && (
    <Section id="experience" title="Experience">
      <div class="relative">
        {experience.map((exp, index) => (
          <div class="relative mb-12 last:mb-0">
            {showTimeline && (
              <div class="absolute left-1/2 -top-2 w-4 h-4 bg-accent rounded-full -translate-x-1/2 z-20" />
            )}

            {showTimeline && index < experience.length - 1 && (
              <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-line-strong -translate-x-1/2 translate-y-full z-10" />
            )}

            <EntryCard
              title={exp.title}
              organization={exp.company}
              dateRange={exp.dateRange}
              items={exp.bullets}
            />
          </div>
        ))}
      </div>
    </Section>
  )
}
