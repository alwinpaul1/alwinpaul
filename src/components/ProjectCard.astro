---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";

interface Props {
  project: (typeof siteConfig.projects)[number];
  index: number;
  // Achievements sit one level deeper, under their own h3
  headingTag?: "h3" | "h4";
}

const { project, index, headingTag: Heading = "h3" } = Astro.props;
const Component = project.link ? "a" : "div";
const linkProps = project.link
  ? {
      href: project.link,
      target: "_blank",
      rel: "noopener noreferrer",
    }
  : {};
---

<div class="reveal group relative">
  <Component
    {...linkProps}
    class={`block relative p-4 sm:p-6 md:p-8 bg-surface rounded-xl sm:rounded-2xl border border-line transition-[translate,scale,background-color,border-color,box-shadow] duration-200 ease-out ${
      project.link
        ? "hover:bg-lift hover:shadow-xl hover:border-line-strong hover:-translate-y-1 active:scale-[0.99]"
        : ""
    }`}
  >
    {
      project.link && (
        <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-solid rounded-full text-solid-fg transition-colors duration-200 group-hover:bg-solid-hover">
          <Icon
            name="arrowUpRight"
            class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </div>
      )
    }

    <div class="space-y-4">
      <div>
        <span class="text-sm font-mono text-accent tabular-nums">
          {String(index + 1).padStart(2, "0")}
        </span>
        <Heading
          class={`text-xl sm:text-2xl font-bold text-ink text-balance mt-1 ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
        >
          {project.name}
        </Heading>
      </div>

      <p
        class={`text-base sm:text-lg text-body leading-relaxed text-pretty ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
      >
        {project.description}
      </p>

      {
        project.skills && project.skills.length > 0 && (
          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2" translate="no">
            {project.skills.map((skill) => (
              <span
                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-solid text-solid-fg rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-colors duration-200 ${
                  project.link ? "group-hover:bg-solid-hover" : ""
                }`}
              >
                {skill}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </Component>
</div>
